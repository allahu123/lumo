 "lesson": {
  "goal_tr": "Tekil bir isimden önce a/an seçebilir, bilinen veya tek olan şeyler için the kullanabilir ve genel çoğullarda tanımlık kullanmayabilirsin.",
  "sections": [
   {
    "heading_tr": "a mı, an mı?",
    "explanation_tr": "a/an tekil, sayılabilen ve henüz belirli olmayan isimlerden önce gelir. Sonraki kelimenin ilk sesine göre sessiz seste a, sesli seste an kullanılır; hour kelimesinde h okunmadığı için an hour denir.",
    "examples": [
     {
      "en": "I have a cat.",
      "tr": "Bir kedim var."
     },
     {
      "en": "I eat an apple.",
      "tr": "Bir elma yerim."
     },
     {
      "en": "I need an hour.",
      "tr": "Bir saate ihtiyacım var."
     }
    ]
   },
   {
    "heading_tr": "the: bilinen veya tek olan şeyler",
    "explanation_tr": "the, hangi şeyden söz ettiğimiz biliniyorsa kullanılır; bu şey daha önce söylenmiş olabilir. Ayrıca bulunduğumuz bağlamda tek olan şeyler için de kullanılır.",
    "examples": [
     {
      "en": "I have a book. The book is good.",
      "tr": "Bir kitabım var. Kitap iyi."
     },
     {
      "en": "The sun is hot.",
      "tr": "Güneş sıcaktır."
     }
    ]
   },
   {
    "heading_tr": "Tanımlık kullanılmayan yerler",
    "explanation_tr": "Genel olarak çoğul şeylerden söz ederken tanımlık kullanmayız. at home gibi bazı kalıplarda da tanımlık kullanılmaz.",
    "examples": [
     {
      "en": "Cats are nice.",
      "tr": "Kediler sevimlidir."
     },
     {
      "en": "I am at home.",
      "tr": "Evdeyim."
     }
    ]
   }
  ],
  "key_patterns": [
   {
