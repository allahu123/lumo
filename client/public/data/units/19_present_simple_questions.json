 ],
 "lesson": {
  "goal_tr": "Bu dersin sonunda geniş zamanda do/does ile soru sorabilir ve kısa cevap verebilirsin.",
  "sections": [
   {
    "heading_tr": "Soru kurma",
    "explanation_tr": "I, you, we ve they ile do; he, she, it ve tekil isimlerle does kullanılır. Sıra şöyledir: Do/Does + özne + fiilin yalın hâli? Soru kelimesi varsa en başa gelir.",
    "examples": [
     {
      "en": "Do you like coffee?",
      "tr": "Kahve sever misin?"
     },
     {
      "en": "Does he work?",
      "tr": "O çalışıyor mu?"
     },
     {
      "en": "Where do you live?",
      "tr": "Nerede yaşıyorsun?"
     }
    ]
   },
   {
    "heading_tr": "Kısa cevaplar",
    "explanation_tr": "Kısa cevapta do veya does, sorudaki özneye göre seçilir. Olumsuz cevapta don't ya da doesn't kullanılır.",
    "examples": [
     {
      "en": "Yes, I do.",
      "tr": "Evet."
     },
     {
      "en": "No, she doesn't.",
      "tr": "Hayır."
     }
    ]
   },
   {
    "heading_tr": "Fiilin yalın hâli",
    "explanation_tr": "Does kullanıldığında ana fiile -s eklenmez; -s, does içinde yer alır. Bu yüzden does'tan sonra fiilin yalın hâlini kullanırız.",
    "examples": [
     {
      "en": "Does she like tea?",
      "tr": "O çay sever mi?"
     },
     {
      "en": "Does she live in Ankara?",
      "tr": "O Ankara'da mı yaşıyor?"
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "Do + I/you/we/they + fiilin yalın hâli?",
    "example_en": "Do you like tea?",
    "example_tr": "Çay sever misin?"
   },
   {
    "pattern": "Does + he/she/it + fiilin yalın hâli?",
    "example_en": "Does he play tennis?",
    "example_tr": "Tenis oynar mı?"
   },
   {
    "pattern": "Soru kelimesi + do/does + özne + fiilin yalın hâli?",
    "example_en": "What does she eat?",
    "example_tr": "O ne yer?"
   },
   {
    "pattern": "Yes, + özne + do/does. No, + özne + don't/doesn't.",
    "example_en": "Yes, I do. No, she doesn't.",
    "example_tr": "Evet. Hayır."
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede soru eki genellikle cümlenin sonundadır; İngilizcede do veya does sorunun başına gelir.",
   "Türkçede fiil çoğunlukla sonda, İngilizcede ise öznenin hemen ardından gelir: Do you like coffee?",
   "Türkçedeki “o” hem he hem she olabilir. İngilizcede he erkek, she kadın için kullanılır.",
   "Türkçede soru için ayrı bir yardımcı fiil yoktur; İngilizcede do/does soru kurmaya yardım eder."
  ],
  "common_mistakes": [
   {
    "wrong": "Does she likes tea?",
    "correct": "Does she like tea?",
    "note_tr": "Does'tan sonra ana fiile -s ekleme."
   },
   {
    "wrong": "Do he live in Ankara?",
    "correct": "Does he live in Ankara?",
    "note_tr": "He ile do değil, does kullan."
   },
   {
    "wrong": "Yes, she do.",
    "correct": "Yes, she does.",
    "note_tr": "Kısa cevapta does, he/she/it ile kullanılır."
   }
  ],
  "mini_dialogue": [
