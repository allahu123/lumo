 "lesson": {
  "goal_tr": "Bu dersin sonunda 0-100 arasındaki sayıları cümlelerde kullanabilir, yaş ve fiyat sorabilir, telefon numarası söyleyebilir ve miktar sorabilirsin.",
  "sections": [
   {
    "heading_tr": "Sayılar",
    "explanation_tr": "Sayıları rakamla da yazabilirsin: “I have 20 books.” 13-19 arasındaki sayıların yazılışında genellikle “-teen”, onluklarda ise “-ty” kullanılır. 21-99 arasındaki sayılar yazıyla yazıldığında onluk ve birlik arasına kısa çizgi konur.",
    "examples": [
     {
      "en": "I have 20 books.",
      "tr": "20 kitabım var."
     },
     {
      "en": "There are 100 people.",
      "tr": "100 kişi var."
     }
    ]
   },
   {
    "heading_tr": "Yaş ve fiyat",
    "explanation_tr": "Yaş söylerken “be + sayı + years old” kalıbını kullanırız; Türkçedeki gibi “yaşında olmak” için “have” kullanılmaz. Fiyat sormak için “How much is it?” deriz; cevaptaysa para birimi çoğul olabilir.",
    "examples": [
     {
      "en": "How old are you?",
      "tr": "Kaç yaşındasın?"
     },
     {
      "en": "I'm 10 years old.",
      "tr": "10 yaşındayım."
     },
     {
      "en": "How much is it?",
      "tr": "Fiyatı ne kadar?"
     },
     {
      "en": "It's five euros.",
      "tr": "Beş euro."
     }
    ]
   },
   {
    "heading_tr": "Miktar ve telefon numarası",
    "explanation_tr": "Sayılabilen şeylerin miktarını sormak için “How many” kullanırız ve ardından çoğul isim gelir. Telefon numaralarını genellikle rakam rakam okuruz.",
    "examples": [
     {
      "en": "How many books are there?",
      "tr": "Kaç kitap var?"
     },
     {
      "en": "There are three books.",
      "tr": "Üç kitap var."
     },
     {
      "en": "My phone number is 2-5-1-4.",
      "tr": "Telefon numaram 2-5-1-4."
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "How old + are + you? → How old are you?",
    "example_en": "How old are you?",
    "example_tr": "Kaç yaşındasın?"
   },
   {
    "pattern": "I + am + sayı + years old → I'm 10 years old.",
    "example_en": "I'm 10 years old.",
    "example_tr": "10 yaşındayım."
   },
   {
    "pattern": "How much + is + it? → How much is it?",
    "example_en": "How much is it?",
    "example_tr": "Fiyatı ne kadar?"
   },
   {
    "pattern": "How many + books + are there? → How many books are there?",
    "example_en": "How many books are there?",
    "example_tr": "Kaç kitap var?"
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede fiil çoğunlukla sonda, İngilizcede ise özne-fiil-nesne sırası kullanılır: “How old are you?” sorusunda “are” özneden sonra gelir.",
   "Türkçede yaşı “10 yaşındayım” diye söyleriz; İngilizcede “I am 10 years old” kalıbında “am” gerekir.",
   "Türkçede sayı söylerken birlik onluktan önce gelir; İngilizcede 21 gibi sayılarda önce onluk, sonra birlik söylenir.",
   "İngilizcede “How many” sonrasında çoğul isim kullanılır; örneğin “books”."
  ],
  "common_mistakes": [
   {
