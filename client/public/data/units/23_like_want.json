 "lesson": {
  "goal_tr": "Bu dersin sonunda neleri sevdiğini, ne istediğini ve neye ihtiyacın olduğunu söyleyebilir, kibarca bir şey isteyebilirsin.",
  "sections": [
   {
    "heading_tr": "Like, love ve hate",
    "explanation_tr": "Bu fiillerden sonra bir isim ya da -ing biçiminde bir fiil kullanılır. Örneğin, “I like tea” ve “I like swimming” diyebilirsin.",
    "examples": [
     {
      "en": "I like tea.",
      "tr": "Çayı severim."
     },
     {
      "en": "I love swimming.",
      "tr": "Yüzmeyi çok severim."
     },
     {
      "en": "I hate rain.",
      "tr": "Yağmurdan nefret ederim."
     }
    ]
   },
   {
    "heading_tr": "Want ve need",
    "explanation_tr": "Want ve need sözcüklerinden sonra bir isim ya da to + fiilin yalın hâli gelir. Örneğin, “I want tea” veya “I want to go” diyebilirsin.",
    "examples": [
     {
      "en": "I want tea.",
      "tr": "Çay istiyorum."
     },
     {
      "en": "I need to go.",
      "tr": "Gitmem gerekiyor."
     }
    ]
   },
   {
    "heading_tr": "Kibar istek ve soru",
    "explanation_tr": "Would like, bir şeyi kibarca istemek için kullanılır; ardından isim ya da to + fiil gelebilir. Like ile soru sorarken başa Do gelir: “Do you like tea?”",
    "examples": [
     {
      "en": "I would like a tea.",
      "tr": "Bir çay alabilir miyim?"
     },
     {
      "en": "Would you like to go?",
      "tr": "Gitmek ister misin?"
     },
     {
      "en": "Do you like tea?",
      "tr": "Çayı sever misin?"
     }
    ]
   },
   {
    "heading_tr": "-ing yazımı",
    "explanation_tr": "Çoğu fiile -ing eklenir. Fiil sonundaki okunmayan e düşer: make → making; bazı kısa fiillerde son harf tekrarlanır: swim → swimming.",
    "examples": [
     {
      "en": "I like swimming.",
      "tr": "Yüzmeyi severim."
     },
     {
      "en": "I like making tea.",
      "tr": "Çay yapmayı severim."
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "I + like + tea",
    "example_en": "I like tea.",
    "example_tr": "Çayı severim."
   },
   {
    "pattern": "I + love + swimming",
    "example_en": "I love swimming.",
    "example_tr": "Yüzmeyi çok severim."
   },
   {
    "pattern": "I + want + to + go",
    "example_en": "I want to go.",
    "example_tr": "Gitmek istiyorum."
   },
   {
    "pattern": "I + need + tea",
    "example_en": "I need tea.",
    "example_tr": "Çaya ihtiyacım var."
   },
   {
    "pattern": "I + would like + a + tea",
    "example_en": "I would like a tea.",
    "example_tr": "Bir çay alabilir miyim?"
   },
   {
    "pattern": "Do + you + like + tea?",
    "example_en": "Do you like tea?",
    "example_tr": "Çayı sever misin?"
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede cümle sırası çoğunlukla özne-nesne-fiildir; İngilizcede fiil genellikle nesneden önce gelir: “I like tea.”",
   "Türkçedeki “-meyi/-mayı” karşılığı her fiille aynı kurulmaz: like ardından swimming, want ardından to swim gelir.",
   "Türkçede soru eki kullanılır; İngilizcede like ile soru kurarken Do başa gelir: “Do you like tea?”"
  ],
