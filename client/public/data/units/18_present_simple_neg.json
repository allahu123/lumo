 "lesson": {
  "goal_tr": "Geniş zamanda don’t ve doesn’t kullanarak olumsuz cümleler kurabilir ve olumlu cümlelerle aralarındaki farkı görebilirsin.",
  "sections": [
   {
    "heading_tr": "Olumsuz cümle kurma",
    "explanation_tr": "I, you, we ve they ile don’t kullanırız. He, she ve it ile doesn’t kullanırız; ardından fiilin yalın hâli gelir.",
    "examples": [
     {
      "en": "I don't like coffee.",
      "tr": "Kahveyi sevmiyorum."
     },
     {
      "en": "She doesn't work.",
      "tr": "O çalışmıyor."
     }
    ]
   },
   {
    "heading_tr": "Doesn’t sonrası fiil",
    "explanation_tr": "Doesn’t kullanınca fiile -s eklemeyiz. -s, olumlu cümlede he, she veya it ile kullanılan fiile gelir.",
    "examples": [
     {
      "en": "He works.",
      "tr": "O çalışır."
     },
     {
      "en": "He doesn't work.",
      "tr": "O çalışmaz."
     }
    ]
   },
   {
    "heading_tr": "Olumlu ve olumsuz anlam",
    "explanation_tr": "Don’t ve doesn’t, cümleye olumsuz anlam katar. Olumlu cümlede bu yardımcıları kullanmayız.",
    "examples": [
     {
      "en": "We live in London.",
      "tr": "Londra’da yaşıyoruz."
     },
     {
      "en": "We don't live in London.",
      "tr": "Londra’da yaşamıyoruz."
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "I / you / we / they + don't + fiilin yalın hâli",
    "example_en": "They don't like tea.",
    "example_tr": "Çayı sevmiyorlar."
   },
   {
    "pattern": "He / she / it + doesn't + fiilin yalın hâli",
    "example_en": "He doesn't work.",
    "example_tr": "O çalışmıyor."
   },
   {
    "pattern": "He / she / it + fiil-s (olumlu)",
    "example_en": "She likes coffee.",
    "example_tr": "O kahveyi sever."
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede olumsuzluk çoğunlukla fiile eklenir; İngilizcede don’t veya doesn’t fiilden önce gelir.",
   "Türkçede yüklem genellikle sonda, İngilizcede ise özneden sonra fiil gelir: “I don’t like coffee.”",
   "Türkçedeki “o” hem kadın hem erkek için kullanılabilir; İngilizcede he ve she ayrımı vardır."
  ],
  "common_mistakes": [
