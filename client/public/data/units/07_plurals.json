  "general_nouns"
 ],
 "lesson": {
  "goal_tr": "Bu dersin sonunda düzenli ve düzensiz isimlerin çoğul biçimlerini kullanabilir, sayılarla doğru çoğul ismi kurabilirsin.",
  "sections": [
   {
    "heading_tr": "1. Düzenli çoğul: -s",
    "explanation_tr": "Çoğu ismin çoğulunu yapmak için sonuna -s eklenir. Bir isimden bir tane varsa tekil, birden fazla varsa çoğul biçimi kullanılır.",
    "examples": [
     {
      "en": "one cat → two cats",
      "tr": "bir kedi → iki kedi"
     },
     {
      "en": "I have two cats.",
      "tr": "İki kedim var."
     }
    ]
   },
   {
    "heading_tr": "2. Yazım değişiklikleri: -es ve -ies",
    "explanation_tr": "Sonu s, sh, ch, x veya z ile biten isimlere genellikle -es eklenir. İsim sessiz harf + y ile bitiyorsa y düşer, yerine -ies gelir.",
    "examples": [
     {
      "en": "one box → two boxes",
      "tr": "bir kutu → iki kutu"
     },
     {
      "en": "one bus → two buses",
      "tr": "bir otobüs → iki otobüs"
     },
     {
      "en": "one city → two cities",
      "tr": "bir şehir → iki şehir"
     }
    ]
   },
   {
    "heading_tr": "3. Düzensiz çoğullar ve sayılar",
    "explanation_tr": "Bazı isimlerin çoğulu kurala uymaz; bu biçimleri öğrenmek gerekir. Birden fazla sayılarla çoğul isim kullanılır: İngilizcede sayıdan sonra isim çoğul olur.",
    "examples": [
     {
      "en": "one child → two children",
      "tr": "bir çocuk → iki çocuk"
     },
     {
      "en": "one man → two men; one woman → two women",
      "tr": "bir erkek → iki erkek; bir kadın → iki kadın"
     },
     {
      "en": "one foot → two feet; one tooth → two teeth",
      "tr": "bir ayak → iki ayak; bir diş → iki diş"
     },
     {
      "en": "one person → two people",
      "tr": "bir kişi → iki kişi"
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "one + cat → one cat; two + cat → two cats",
    "example_en": "I have two cats.",
    "example_tr": "İki kedim var."
   },
   {
    "pattern": "one + box → one box; two + box → two boxes",
    "example_en": "I have two boxes.",
    "example_tr": "İki kutum var."
   },
   {
    "pattern": "one + city → one city; two + city → two cities",
    "example_en": "Two cities.",
    "example_tr": "İki şehir."
   },
   {
    "pattern": "one + child → one child; two + child → two children",
    "example_en": "There are two children.",
    "example_tr": "İki çocuk var."
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede sayıdan sonra isim genellikle tekil kalır: “iki kedi”. İngilizcede sayı birden fazlaysa isim çoğul olur: “two cats”.",
   "Türkçede çoğul eki -lar/-ler, İngilizcede ise çoğu isimde -s kullanılır; ancak -es, -ies ve düzensiz biçimlere dikkat et."
  ],
  "common_mistakes": [
   {
