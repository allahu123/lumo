 "lesson": {
  "goal_tr": "Bu dersin sonunda selamlaşabilir, kendinizi tanıtabilir, birinin nasıl olduğunu ve nereli olduğunu sorup cevaplayabilirsiniz.",
  "sections": [
   {
    "heading_tr": "Selamlaşma ve vedalaşma",
    "explanation_tr": "Karşılaşınca “Hello” veya “Hi” diyebilirsiniz. Ayrılırken “Goodbye” ya da “See you” kullanabilirsiniz.",
    "examples": [
     {
      "en": "Hello!",
      "tr": "Merhaba!"
     },
     {
      "en": "See you!",
      "tr": "Görüşürüz!"
     }
    ]
   },
   {
    "heading_tr": "İsim söyleme ve tanışma",
    "explanation_tr": "İsminizi söylemek için “My name is…” veya “I'm…” kalıbını kullanın. Tanıştığınız kişiye “Nice to meet you” diyebilirsiniz.",
    "examples": [
     {
      "en": "My name is Ali.",
      "tr": "Benim adım Ali."
     },
     {
      "en": "I'm Anna.",
      "tr": "Ben Anna."
     },
     {
      "en": "Nice to meet you.",
      "tr": "Tanıştığımıza memnun oldum."
     }
    ]
   },
   {
    "heading_tr": "Hâl hatır ve nereli olduğunu sorma",
    "explanation_tr": "“How are you?” diye sorabilirsiniz; “I'm fine, thanks. And you?” ile cevap verebilirsiniz. Nereli olduğunu sormak için “Where are you from?”, cevap vermek için “I'm from Turkey” kullanın.",
    "examples": [
     {
      "en": "How are you?",
      "tr": "Nasılsın?"
     },
     {
      "en": "I'm fine, thanks. And you?",
      "tr": "İyiyim, teşekkürler. Ya sen?"
     },
     {
      "en": "Where are you from?",
      "tr": "Nerelisin?"
     },
     {
      "en": "I'm from Turkey.",
      "tr": "Türkiye'denim."
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "My name + is + name",
    "example_en": "My name is Ali.",
    "example_tr": "Benim adım Ali."
   },
   {
    "pattern": "I + am + name → I'm + name",
    "example_en": "I'm Anna.",
    "example_tr": "Ben Anna."
   },
   {
    "pattern": "How + are + you?",
    "example_en": "How are you?",
    "example_tr": "Nasılsın?"
   },
   {
    "pattern": "I + am + from + place → I'm + from + place",
    "example_en": "I'm from Turkey.",
    "example_tr": "Türkiye'denim."
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede “İyiyim” derken özneyi söylemeyebilirsiniz; İngilizcede “I'm fine” derken “I” gerekir.",
   "Türkçede “Benim adım Ali” deriz. İngilizcede sıra “My name is Ali” şeklindedir.",
   "Bu kalıpta ülke adından önce “the” gelmez: “I'm from Turkey.”"
  ],
  "common_mistakes": [
   {
    "wrong": "I from Turkey.",
    "correct": "I'm from Turkey.",
    "note_tr": "İngilizcede “I” ile “from” arasında “am” gerekir."
   },
   {
    "wrong": "My name Ali.",
    "correct": "My name is Ali.",
    "note_tr": "Bu kalıpta “name” ile isim arasına “is” gelir."
   },
   {
    "wrong": "How you are?",
    "correct": "How are you?",
    "note_tr": "Soruda “are”, “you”dan önce gelir."
   },
   {
    "wrong": "I'm from the Turkey.",
    "correct": "I'm from Turkey.",
    "note_tr": "Bu kalıpta “Turkey” önüne “the” eklemeyin."
   }
  ],
  "mini_dialogue": [
   {
    "speaker": "Anna",
    "en": "Hello, Ali. My name is Anna.",
    "tr": "Merhaba Ali. Benim adım Anna."
   },
   {
    "speaker": "Ali",
    "en": "Hi, Anna. I'm Ali. Nice to meet you.",
    "tr": "Merhaba Anna. Ben Ali. Tanıştığımıza memnun oldum."
   },
   {
    "speaker": "Anna",
    "en": "Nice to meet you, too. Where are you from?",
    "tr": "Ben de tanıştığımıza memnun oldum. Nerelisin?"
   },
   {
    "speaker": "Ali",
    "en": "I'm from Turkey. How are you?",
    "tr": "Türkiye'denim. Nasılsın?"
   },
   {
    "speaker": "Anna",
    "en": "I'm fine, thanks. And you?",
    "tr": "İyiyim, teşekkürler. Ya sen?"
   },
   {
    "speaker": "Ali",
    "en": "I'm fine, thanks. Goodbye!",
    "tr": "İyiyim, teşekkürler. Hoşça kal!"
   }
  ]
 },
