 "title_en": "Verb to be: negatives and questions",
 "title_tr": "To be fiili: olumsuz ve soru",
 "level": "A1",
 "related_vocab_topics": [
  "pronouns_grammar",
  "question_words_conjunctions"
 ],
 "lesson": {
  "goal_tr": "Bu dersin sonunda am not, isn't ve aren't ile olumsuz cümleler kurabilir, be fiiliyle soru sorup kısa cevap verebilirsin.",
  "sections": [
   {
    "heading_tr": "Olumsuz cümleler",
    "explanation_tr": "Olumsuzluk için am, is veya are'den sonra not gelir. Kısa biçimler is not → isn't ve are not → aren't şeklindedir; “I am not” için “I'm not” denir.",
    "examples": [
     {
      "en": "I am not tired.",
      "tr": "Yorgun değilim."
     },
     {
      "en": "He isn't happy.",
      "tr": "O mutlu değil."
     },
     {
      "en": "They aren't at home.",
      "tr": "Onlar evde değil."
     }
    ]
   },
   {
    "heading_tr": "Soru cümleleri",
    "explanation_tr": "Soru yaparken am, is veya are öznenin önüne gelir. İngilizcede soru sırası genellikle be fiili + özne + cümlenin geri kalanı şeklindedir.",
    "examples": [
     {
      "en": "Am I late?",
      "tr": "Geç mi kaldım?"
     },
     {
      "en": "Is she a teacher?",
      "tr": "O öğretmen mi?"
     },
     {
      "en": "Are you ready?",
      "tr": "Hazır mısın?"
     }
    ]
   },
   {
    "heading_tr": "Kısa cevaplar",
    "explanation_tr": "Kısa cevapta yes veya no'dan sonra özne ve uygun be fiili kullanılır. Olumlu cevapta fiili kısaltmayız: “Yes, I am.”",
    "examples": [
     {
      "en": "Are you a student? Yes, I am.",
      "tr": "Öğrenci misin? Evet, öğrenciyim."
     },
     {
      "en": "Is he at home? No, he isn't.",
      "tr": "O evde mi? Hayır, evde değil."
     },
     {
      "en": "Are they ready? No, they aren't.",
      "tr": "Onlar hazır mı? Hayır, hazır değiller."
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "I + am not + ...",
    "example_en": "I am not tired.",
    "example_tr": "Yorgun değilim."
   },
   {
    "pattern": "He / She / It + isn't + ...",
    "example_en": "She isn't at home.",
    "example_tr": "O evde değil."
   },
   {
    "pattern": "You / We / They + aren't + ...",
    "example_en": "We aren't busy.",
    "example_tr": "Meşgul değiliz."
   },
   {
    "pattern": "Am / Is / Are + özne + ...?",
    "example_en": "Are you happy?",
    "example_tr": "Mutlu musun?"
   },
   {
    "pattern": "Yes / No + özne + uygun be fiili",
    "example_en": "No, he isn't.",
    "example_tr": "Hayır, o değil."
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede “Mutluyum” derken ayrı bir “olmak” sözcüğü kullanmayız; İngilizcede ise “I am happy” gibi am/is/are gerekir.",
   "Türkçede yüklem genellikle cümlenin sonundadır; İngilizcede “Are you happy?” sorusunda be fiili öznenin önüne geçer.",
   "Türkçedeki “o” kadın ve erkek için aynıdır; İngilizcede kadın için she, erkek için he kullanılır.",
   "Tekil sayılabilen bir mesleğin önünde genellikle a/an gerekir: “I am a teacher.”"
  ],
  "common_mistakes": [
   {
    "wrong": "I not happy.",
    "correct": "I am not happy.",
    "note_tr": "İngilizcede olumsuz cümlede am/is/are atlanmaz."
   },
   {
    "wrong": "Is you a student?",
    "correct": "Are you a student?",
    "note_tr": "You ile soru kurarken are kullanılır."
   },
   {
    "wrong": "Yes, I are.",
    "correct": "Yes, I am.",
    "note_tr": "I öznesiyle am kullanılır; kısa cevapta da fiil özneye uyar."
   },
   {
    "wrong": "He aren't happy.",
    "correct": "He isn't happy.",
    "note_tr": "He ile is veya isn't kullanılır; aren't, you, we ve they ile kullanılır."
   }
  ],
  "mini_dialogue": [
