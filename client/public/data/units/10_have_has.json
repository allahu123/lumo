 "title_en": "Have and has",
 "title_tr": "Have / has (sahip olmak)",
 "level": "A1",
 "related_vocab_topics": [
  "family_people",
  "general_nouns"
 ],
 "lesson": {
  "goal_tr": "Bu dersin sonunda sahip olduğun şeyleri ve yaptığın bazı günlük etkinlikleri have/has ile anlatabilirsin.",
  "sections": [
   {
    "heading_tr": "Have mi, has mi?",
    "explanation_tr": "I, you, we ve they ile have kullanılır. He, she ve it ile has kullanılır.",
    "examples": [
     {
      "en": "I have a brother.",
      "tr": "Bir erkek kardeşim var."
     },
     {
      "en": "She has a cat.",
      "tr": "Onun bir kedisi var."
     }
    ]
   },
   {
    "heading_tr": "Neler için kullanılır?",
    "explanation_tr": "Have/has; aile üyelerinden, evcil hayvanlardan ve eşyalardan söz ederken kullanılır. Ayrıca kahvaltı etmek veya duş almak gibi bazı günlük etkinlikleri anlatır.",
    "examples": [
     {
      "en": "We have breakfast at eight.",
      "tr": "Saat sekizde kahvaltı ederiz."
     },
     {
      "en": "He has a shower in the morning.",
      "tr": "Sabah duş alır."
     }
    ]
   },
   {
    "heading_tr": "Olumsuz cümleler",
    "explanation_tr": "Olumsuz cümlelerde I, you, we ve they ile don't; he, she ve it ile doesn't kullanılır. Don't veya doesn't sonrasında has değil, have gelir.",
    "examples": [
     {
      "en": "I don't have a sister.",
      "tr": "Bir kız kardeşim yok."
     },
     {
      "en": "He doesn't have a dog.",
      "tr": "Onun bir köpeği yok."
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "I/you/we/they + have + a thing",
    "example_en": "They have a car.",
    "example_tr": "Onların bir arabası var."
   },
   {
    "pattern": "He/she/it + has + a thing",
    "example_en": "He has a book.",
    "example_tr": "Onun bir kitabı var."
   },
   {
    "pattern": "I/you/we/they + don't + have + a thing; he/she/it + doesn't + have + a thing",
    "example_en": "She doesn't have a dog.",
    "example_tr": "Onun bir köpeği yok."
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçedeki “Bir kedim var” cümlesi İngilizcede “I have a cat” olur; have, öznenin ardından gelir.",
   "Türkçede “o” kadın ya da erkek için kullanılabilir; İngilizcede kadın için she, erkek için he, eşya veya hayvan için çoğunlukla it kullanılır.",
   "İngilizcede tekil sayılabilen isimlerin önünde çoğunlukla a/an gerekir: a cat, a book."
  ],
  "common_mistakes": [
   {
    "wrong": "He have a dog.",
    "correct": "He has a dog.",
    "note_tr": "He ile have değil, has kullanılır."
   },
   {
    "wrong": "She doesn't has a cat.",
    "correct": "She doesn't have a cat.",
    "note_tr": "Doesn't kullanıldığında ardından have gelir."
   },
   {
    "wrong": "I have cat.",
    "correct": "I have a cat.",
    "note_tr": "Tekil sayılabilen cat kelimesinden önce a gerekir."
   }
  ],
  "mini_dialogue": [
   {
