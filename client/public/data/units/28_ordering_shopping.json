 "lesson": {
  "goal_tr": "Bu dersin sonunda kafede veya dükkânda kibarca bir şey isteyebilir, fiyat sorabilir ve yakında bir yer olup olmadığını sorabilirsiniz.",
  "sections": [
   {
    "heading_tr": "Kibarca bir şey isteme",
    "explanation_tr": "Bir şey isterken “Can I have + ürün?” veya “I’d like + ürün” kullanın. “I’d like” daha nazik bir istek kalıbıdır; lütfen eklemek için “please” diyebilirsiniz.",
    "examples": [
     {
      "en": "Can I have a coffee, please?",
      "tr": "Bir kahve alabilir miyim, lütfen?"
     },
     {
      "en": "I'd like a sandwich, please.",
      "tr": "Bir sandviç istiyorum, lütfen."
     }
    ]
   },
   {
    "heading_tr": "Ürün, fiyat ve ödeme",
    "explanation_tr": "Tek bir sayılabilir üründen söz ederken genellikle “a” veya “an” kullanılır: “a cake”, “an apple”. Fiyat sormak için “How much is it?” deyin; hesabı istemek için “The bill, please.” ifadesini kullanın.",
    "examples": [
     {
      "en": "How much is it?",
      "tr": "Ne kadar?"
     },
     {
      "en": "The bill, please.",
      "tr": "Hesap, lütfen."
     }
    ]
   },
   {
    "heading_tr": "Bir yerin olup olmadığını sorma",
    "explanation_tr": "Bir yerde bir şey olup olmadığını sormak için “Is there + a/an + yer?” kalıbını kullanın. Satıcı “Anything else?” diyerek başka bir şey isteyip istemediğinizi sorabilir; ürünü verirken “Here you are.” der.",
    "examples": [
     {
      "en": "Is there a supermarket?",
      "tr": "Bir süpermarket var mı?"
     },
     {
      "en": "Anything else?",
      "tr": "Başka bir şey?"
     },
     {
      "en": "Here you are.",
      "tr": "Buyurun."
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "Can I have + a/an + [thing]?",
    "example_en": "Can I have an apple, please?",
    "example_tr": "Bir elma alabilir miyim, lütfen?"
   },
   {
    "pattern": "I'd like + a/an + [thing].",
    "example_en": "I'd like a cake, please.",
    "example_tr": "Bir pasta istiyorum, lütfen."
   },
   {
    "pattern": "How much + is + it?",
    "example_en": "How much is it?",
    "example_tr": "Ne kadar?"
   },
   {
    "pattern": "Is + there + a/an + [place]?",
    "example_en": "Is there a cafe?",
    "example_tr": "Bir kafe var mı?"
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede “Bir kahve alabilir miyim?” deriz; İngilizcede sayılabilir tek bir ürün için “a” veya “an” gerekir: “a coffee”, “an apple”.",
   "Türkçede fiil genellikle sonda, İngilizcede ise özneden sonra gelir. Soru yaparken “How much is it?” ve “Is there a cafe?” örneklerindeki kelime sırasına dikkat edin.",
   "“Here you are.” kelime kelime çevrilmez; bir şeyi uzatırken Türkçedeki “Buyurun.” anlamında kullanılır."
  ],
  "common_mistakes": [
   {
    "wrong": "Can I have apple, please?",
    "correct": "Can I have an apple, please?",
    "note_tr": "Tek bir sayılabilir ürünü isterken “an” gerekir; “apple” sesli harfle başladığı için “an” kullanılır."
   },
