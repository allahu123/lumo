 "lesson": {
  "goal_tr": "Bu dersin sonunda basit emirler verebilir, birini nazikçe bir şey yapmaya davet edebilir ve kibarca bir şey isteyebilirsin.",
  "sections": [
   {
    "heading_tr": "Emir verme ve olumsuz emir",
    "explanation_tr": "Emir verirken fiilin yalın hâliyle başla; “you” genellikle söylenmez. Olumsuz emir için “Don't” kelimesini fiilden önce kullan.",
    "examples": [
     {
      "en": "Open the door.",
      "tr": "Kapıyı aç."
     },
     {
      "en": "Don't run.",
      "tr": "Koşma."
     }
    ]
   },
   {
    "heading_tr": "Davet ve “be” ile emir",
    "explanation_tr": "Birlikte bir şey yapmayı önermek için “Let's” kelimesinden sonra fiilin yalın hâlini kullan. “Be” ile başlayan emirlerde ardından bir sıfat gelebilir.",
    "examples": [
     {
      "en": "Let's go!",
      "tr": "Hadi gidelim!"
     },
     {
      "en": "Be quiet.",
      "tr": "Sessiz ol."
     },
     {
      "en": "Be careful.",
      "tr": "Dikkatli ol."
     }
    ]
   },
   {
    "heading_tr": "Nazik rica ve teşekkür",
    "explanation_tr": "Nazikçe birinden bir şey yapmasını istemek için “Could you” ve ardından fiilin yalın hâlini kullan. Bir şey isterken “Can I have” diyebilirsin; “please” ricayı nazikleştirir, “Thank you” veya “Thanks” ise teşekkür eder.",
    "examples": [
     {
      "en": "Could you open the door, please?",
      "tr": "Kapıyı açabilir misin, lütfen?"
     },
     {
      "en": "Can I have a glass of water, please?",
      "tr": "Bir bardak su alabilir miyim, lütfen?"
     },
     {
      "en": "Thank you.",
      "tr": "Teşekkür ederim."
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "Fiil + nesne",
    "example_en": "Open the door.",
    "example_tr": "Kapıyı aç."
   },
   {
    "pattern": "Don't + fiil",
    "example_en": "Don't run.",
    "example_tr": "Koşma."
   },
   {
    "pattern": "Let's + fiil",
    "example_en": "Let's go!",
    "example_tr": "Hadi gidelim!"
   },
   {
    "pattern": "Be + sıfat",
    "example_en": "Be careful.",
    "example_tr": "Dikkatli ol."
   },
   {
    "pattern": "Could you + fiil, please?",
    "example_en": "Could you sit down, please?",
    "example_tr": "Oturabilir misin, lütfen?"
   },
   {
    "pattern": "Can I have + isim, please?",
    "example_en": "Can I have a book, please?",
    "example_tr": "Bir kitap alabilir miyim, lütfen?"
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede olduğu gibi emirlerde özne çoğu zaman söylenmez; İngilizcede de doğrudan fiille başlayabilirsin.",
   "Olumsuz emirde Türkçede olumsuzluk fiile eklenir; İngilizcede “don't” fiilden önce gelir: “Don't run.”",
   "Türkçede fiil genellikle cümlenin sonunda, İngilizcede ise çoğunlukla özneden sonra gelir. “Could you open the door?” kalıbında “could you” kısmını fiilden önce kullan.",
   "Emirler tek başına sert duyulabilir. “Please” eklemek rica ifadesini daha nazik yapar."
  ],
  "common_mistakes": [
