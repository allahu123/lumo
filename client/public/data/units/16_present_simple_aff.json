 "lesson": {
  "goal_tr": "Bu dersin sonunda günlük alışkanlıklarınızı ve genel gerçekleri geniş zamanın olumlu biçimiyle anlatabilirsiniz.",
  "sections": [
   {
    "heading_tr": "Cümle yapısı",
    "explanation_tr": "Olumlu cümlede özne fiilden önce gelir. I/you/we/they ile fiilin yalın hâlini, he/she/it ile fiile ek almış hâlini kullanırız. I work every day. (Her gün çalışırım.) He works every day. (Her gün çalışır.)",
    "examples": [
     {
      "en": "I work every day.",
      "tr": "Her gün çalışırım."
     },
     {
      "en": "He works every day.",
      "tr": "Her gün çalışır."
     }
    ]
   },
   {
    "heading_tr": "Kullanım",
    "explanation_tr": "Geniş zamanı günlük rutinler, alışkanlıklar ve genel gerçekler için kullanırız. I eat breakfast every day. (Her gün kahvaltı ederim.) Birds fly. (Kuşlar uçar.)",
    "examples": [
     {
      "en": "I eat breakfast every day.",
      "tr": "Her gün kahvaltı ederim."
     },
     {
      "en": "Birds fly.",
      "tr": "Kuşlar uçar."
     }
    ]
   },
   {
    "heading_tr": "Yazım değişiklikleri",
    "explanation_tr": "He/she/it ile çoğu fiile -s eklenir; sonu -o, -ch, -sh veya -x olan fiillere genellikle -es gelir. Sessiz harften sonra gelen -y, -ies olur; sesli harften sonra gelen -y ise değişmez, yalnızca -s alır. He goes to school. (Okula gider.) She watches TV. (TV izler.) She studies at home. (Evde ders çalışır.)",
    "examples": [
     {
      "en": "He goes to school.",
      "tr": "Okula gider."
     },
     {
      "en": "She watches TV.",
      "tr": "TV izler."
     },
     {
      "en": "She studies at home.",
      "tr": "Evde ders çalışır."
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "I/you/we/they + work",
    "example_en": "I work every day.",
    "example_tr": "Her gün çalışırım."
   },
   {
    "pattern": "he/she/it + fiil-s",
    "example_en": "He works every day.",
    "example_tr": "Her gün çalışır."
   },
   {
    "pattern": "go → goes; watch → watches; study → studies",
    "example_en": "She studies at home.",
    "example_tr": "Evde ders çalışır."
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede özne çoğu zaman söylenmez; İngilizcede olumlu cümlede özneyi genellikle kullanırız.",
   "Türkçede fiil çoğunlukla cümlenin sonunda, İngilizcede ise özne-fiil sırasıyla gelir.",
   "Türkçedeki “o”, İngilizcede kişiye ya da şeye göre he, she veya it olur.",
   "Türkçede geniş zaman ekleri özneye göre değişebilir; İngilizcede fiile -s eki yalnızca he, she ve it ile gelir."
  ],
