 ],
 "lesson": {
  "goal_tr": "Bu dersin sonunda kişi ve eşyalar için doğru özne zamirini ve iyelik sıfatını seçebilirsin.",
  "sections": [
   {
    "heading_tr": "Özne zamirleri",
    "explanation_tr": "I (ben), you (sen/siz), he (erkek için o), she (kadın için o), it (eşya veya hayvan için o), we (biz) ve they (onlar) cümlede özne olarak kullanılır. Özne genellikle fiilden önce gelir: I read.",
    "examples": [
     {
      "en": "She is happy.",
      "tr": "O mutlu."
     },
     {
      "en": "They are here.",
      "tr": "Onlar burada."
     }
    ]
   },
   {
    "heading_tr": "İyelik sıfatları",
    "explanation_tr": "Eşleşmeler şöyledir: I–my, you–your, he–his, she–her, it–its, we–our, they–their. İyelik sıfatı, sahip olunan isimden önce gelir.",
    "examples": [
     {
      "en": "My name is Ali.",
      "tr": "Benim adım Ali."
     },
     {
      "en": "Her sister is here.",
      "tr": "Onun kız kardeşi burada."
     }
    ]
   },
   {
    "heading_tr": "Doğru biçimi seçme ve yazım",
    "explanation_tr": "Özne zamirini kişi ya da şeye göre, iyelik sıfatını ise sahip olan kişiye göre seç. Aynı iyelik sıfatı tekil ve çoğul isimlerle kullanılabilir: his book, his books. Its iyelik bildirir; it’s ise it is kısaltmasıdır.",
    "examples": [
     {
      "en": "He is my brother.",
      "tr": "O benim erkek kardeşim."
     },
     {
      "en": "Its name is Tom.",
      "tr": "Onun adı Tom."
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "Özne zamiri + be fiili + isim",
    "example_en": "She is my sister.",
    "example_tr": "O benim kız kardeşim."
   },
   {
    "pattern": "İyelik sıfatı + isim",
    "example_en": "Their house is big.",
    "example_tr": "Onların evi büyük."
   },
   {
    "pattern": "Özne zamiri + be fiili + iyelik sıfatı + isim",
    "example_en": "He is our friend.",
    "example_tr": "O bizim arkadaşımız."
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçedeki “o” kadın, erkek ve eşyalar için kullanılabilir; İngilizcede insanlar için genellikle he veya she, eşyalar için it kullanılır.",
   "Türkçede iyelik çoğu zaman ismin sonuna eklenir; İngilizcede my, your, his gibi kelimeler isimden önce gelir.",
   "Türkçede özne sık sık söylenmeden bırakılabilir. İngilizcede ise özneyi genellikle açıkça kullanırız: I read."
  ],
  "common_mistakes": [
   {
    "wrong": "He is my sister.",
    "correct": "She is my sister.",
    "note_tr": "Kız kardeş için she kullanılır; Türkçedeki “o” İngilizcedeki bu ayrımı göstermez."
   },
   {
    "wrong": "I name is Ali.",
    "correct": "My name is Ali.",
    "note_tr": "İsimden önce özne zamiri I değil, iyelik sıfatı my kullanılır."
   },
   {
    "wrong": "She is he sister.",
    "correct": "She is his sister.",
    "note_tr": "Bir erkeğe ait olan şeyi belirtirken he değil, his kullanılır."
   }
  ],
  "mini_dialogue": [
   {
    "speaker": "Anna",
    "en": "Is this your book?",
    "tr": "Bu senin kitabın mı?"
   },
   {
    "speaker": "Ali",
    "en": "Yes. It is my book.",
    "tr": "Evet. O benim kitabım."
   },
   {
    "speaker": "Anna",
    "en": "Is your sister here?",
    "tr": "Kız kardeşin burada mı?"
   },
   {
    "speaker": "Ali",
    "en": "Yes. She is here. Her name is Sara.",
    "tr": "Evet. O burada. Onun adı Sara."
   },
   {
    "speaker": "Anna",
    "en": "Is Tom your brother?",
    "tr": "Tom senin erkek kardeşin mi?"
   },
   {
    "speaker": "Ali",
    "en": "No. He is my friend. His name is Tom.",
    "tr": "Hayır. O benim arkadaşım. Onun adı Tom."
   }
  ]
 },
