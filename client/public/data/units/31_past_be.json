 "title_en": "Past of be: was and were (bonus A1+)",
 "title_tr": "Be fiilinin geçmişi: was / were (bonus A1+)",
 "level": "A1",
 "related_vocab_topics": [
  "daily_verbs",
  "numbers_time"
 ],
 "lesson": {
  "goal_tr": "Bu dersin sonunda geçmişte nerede olduğunu veya nasıl hissettiğini was/were ile anlatabilir ve soru sorabilirsin.",
  "sections": [
   {
    "heading_tr": "Olumlu cümleler",
    "explanation_tr": "I, he, she ve it ile was; you, we ve they ile were kullanılır. Was/were, Türkçedeki “idi” anlamını verebilir: I was tired = Yorgundum.",
    "examples": [
     {
      "en": "I was at home yesterday.",
      "tr": "Dün evdeydim."
     },
     {
      "en": "They were happy last week.",
      "tr": "Geçen hafta mutluydular."
     }
    ]
   },
   {
    "heading_tr": "Olumsuz cümleler",
    "explanation_tr": "Olumsuz yapmak için was veya were sonuna not eklenir. Kısa biçimleri wasn't ve weren't şeklindedir.",
    "examples": [
     {
      "en": "She wasn't at school yesterday.",
      "tr": "Dün okulda değildi."
     },
     {
      "en": "We weren't busy.",
      "tr": "Meşgul değildik."
     }
    ]
   },
   {
    "heading_tr": "Sorular ve zaman ifadeleri",
    "explanation_tr": "Soru sorarken was veya were cümlenin başına gelir. Yesterday “dün”, last week “geçen hafta”, ago ise “önce” anlamına gelir.",
    "examples": [
     {
      "en": "Was he at home yesterday?",
      "tr": "Dün evde miydi?"
     },
     {
      "en": "Were you busy last week?",
      "tr": "Geçen hafta meşgul müydün?"
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "I / he / she / it + was + ...",
    "example_en": "She was happy yesterday.",
    "example_tr": "Dün mutluydu."
   },
   {
    "pattern": "You / we / they + were + ...",
    "example_en": "They were at home last week.",
    "example_tr": "Geçen hafta evdeydiler."
   },
   {
    "pattern": "Was + he / she / it + ...?",
    "example_en": "Was he at home yesterday?",
    "example_tr": "Dün evde miydi?"
   },
   {
    "pattern": "Were + you / we / they + ...?",
    "example_en": "Were you tired last night?",
    "example_tr": "Dün gece yorgun muydun?"
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede “Dün evdeydim” derken ayrı bir “idi” sözcüğü kullanmayız; İngilizcede ise I was demek gerekir.",
   "İngilizcede özneyi genellikle söylemek gerekir: “Yorgundum” için I was tired denir.",
   "Türkçedeki “o” cinsiyet belirtmez; İngilizcede kişi için he veya she, nesne ya da hayvan için it kullanılır.",
   "İngilizcede soru yaparken was/were öznenin önüne geçer: Were you...? Türkçede soru eki cümlenin sonunda bulunur."
  ],
  "common_mistakes": [
   {
    "wrong": "I were at home yesterday.",
    "correct": "I was at home yesterday.",
    "note_tr": "I ile were değil, was kullanılır."
   },
   {
    "wrong": "They was happy.",
    "correct": "They were happy.",
    "note_tr": "They ile were kullanılır."
   },
   {
    "wrong": "Did you were at home?",
    "correct": "Were you at home?",
    "note_tr": "Was/were ile soru yaparken başa did getirilmez; was veya were başa alınır."
   }
  ],
  "mini_dialogue": [
