 "title_en": "This, that, these, those",
 "title_tr": "This, that, these, those",
 "level": "A1",
 "related_vocab_topics": [
  "pronouns_grammar",
  "home_furniture"
 ],
 "lesson": {
  "goal_tr": "Bu dersin sonunda yakındaki ve uzaktaki tekil ya da çoğul şeyleri gösterebilir ve onlar hakkında soru sorabilirsin.",
  "sections": [
   {
    "heading_tr": "Yakındaki ve uzaktaki tekil şeyler",
    "explanation_tr": "Yakındaki tek bir şey için “this”, uzaktaki tek bir şey için “that” kullanılır. İkisinden sonra da “is” gelir. Sayılabilen tekil isimlerle “a” veya “an” kullanılır.",
    "examples": [
     {
      "en": "This is a book.",
      "tr": "Bu bir kitap."
     },
     {
      "en": "That is an apple.",
      "tr": "Şu/O bir elma."
     }
    ]
   },
   {
    "heading_tr": "Yakındaki ve uzaktaki çoğul şeyler",
    "explanation_tr": "Yakındaki birden fazla şey için “these”, uzaktaki birden fazla şey için “those” kullanılır. Bu kelimelerle “are” gelir ve çoğul isim kullanılır; çoğul isimlerle “a/an” kullanılmaz.",
    "examples": [
     {
      "en": "These are books.",
      "tr": "Bunlar kitap."
     },
     {
      "en": "Those are apples.",
      "tr": "Şunlar/Onlar elma."
     }
    ]
   },
   {
    "heading_tr": "Soru sorma",
    "explanation_tr": "Tekil bir şeyi sormak için “What is this?” veya “What is that?” diyebilirsin. Çoğul şeyleri sormak için “What are these?” veya “What are those?” kullanılır.",
    "examples": [
     {
      "en": "What is this?",
      "tr": "Bu ne?"
     },
     {
      "en": "What are those?",
      "tr": "Şunlar/Onlar ne?"
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "This + is + a/an + [tekil isim]",
    "example_en": "This is a pen.",
    "example_tr": "Bu bir kalem."
   },
   {
    "pattern": "That + is + a/an + [tekil isim]",
    "example_en": "That is a chair.",
    "example_tr": "Şu/O bir sandalye."
   },
   {
    "pattern": "These + are + [çoğul isim]",
    "example_en": "These are books.",
    "example_tr": "Bunlar kitap."
   },
   {
    "pattern": "Those + are + [çoğul isim]",
    "example_en": "Those are apples.",
    "example_tr": "Şunlar/Onlar elma."
   },
   {
    "pattern": "What + is + this/that?",
    "example_en": "What is that?",
    "example_tr": "Şu/O ne?"
   },
   {
    "pattern": "What + are + these/those?",
    "example_en": "What are these?",
    "example_tr": "Bunlar ne?"
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçedeki “bu, şu, o” ayrımı İngilizceyle birebir örtüşmez: “this/these” yakındakiler, “that/those” uzaktakiler içindir.",
   "İngilizcede tekil ve çoğul için ayrı gösterme kelimeleri vardır: “this/that” tekil, “these/those” çoğuldur.",
   "Türkçede isimden önce “a/an” kullanılmaz; İngilizcede sayılabilen tekil isimle genellikle “a/an” gerekir: “a book”, “an apple”."
  ],
  "common_mistakes": [
   {
    "wrong": "These is a book.",
    "correct": "This is a book.",
    "note_tr": "“These” çoğul içindir; tek bir şey için “this” kullan."
   },
   {
    "wrong": "That are a bag.",
    "correct": "That is a bag.",
    "note_tr": "“That” tekil olduğu için ardından “is” gelir."
   },
   {
    "wrong": "What are this?",
    "correct": "What is this?",
    "note_tr": "Tekil “this” ile “is” kullanılır."
   },
   {
    "wrong": "This is book.",
    "correct": "This is a book.",
    "note_tr": "Sayılabilen tekil “book” kelimesinden önce “a” gerekir."
   }
  ],
  "mini_dialogue": [
