 "lesson": {
  "goal_tr": "Gün ve ayları kullanarak gün, tarih ve günün bölümlerinden ne zaman söz edeceğini öğrenebilirsin.",
  "sections": [
   {
    "heading_tr": "Günler ve aylar",
    "explanation_tr": "Haftanın günlerinden önce on, aylardan önce in kullanılır. Gün ve ay adları İngilizcede büyük harfle başlar.",
    "examples": [
     {
      "en": "I study on Monday.",
      "tr": "Pazartesi ders çalışırım."
     },
     {
      "en": "My birthday is in June.",
      "tr": "Doğum günüm haziranda."
     }
    ]
   },
   {
    "heading_tr": "Günün bölümleri ve hafta sonu",
    "explanation_tr": "Sabah, öğleden sonra ve akşam için in the kullanılır; gece için at night denir. Bu derste hafta sonu için at the weekend kalıbını kullanıyoruz.",
    "examples": [
     {
      "en": "I read in the morning.",
      "tr": "Sabah okurum."
     },
     {
      "en": "I sleep at night.",
      "tr": "Gece uyurum."
     },
     {
      "en": "I play tennis at the weekend.",
      "tr": "Hafta sonu tenis oynarım."
     }
    ]
   },
   {
    "heading_tr": "Tarihler ve gün sorma",
    "explanation_tr": "Tarihlerden önce on kullanılır; örneğin on June fifth. Bugünün hangi gün olduğunu sormak için What day is it today? diyebilirsin; yanıtı It is Monday. şeklinde verebilirsin.",
    "examples": [
     {
      "en": "My birthday is on June fifth.",
      "tr": "Doğum günüm 5 Haziran'da."
     },
     {
      "en": "What day is it today? It is Monday.",
      "tr": "Bugün günlerden ne? Pazartesi."
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "on + gün",
    "example_en": "I study on Monday.",
    "example_tr": "Pazartesi ders çalışırım."
   },
   {
    "pattern": "in + ay",
    "example_en": "My birthday is in June.",
    "example_tr": "Doğum günüm haziranda."
   },
   {
    "pattern": "in the + morning/afternoon/evening",
    "example_en": "I read in the morning.",
    "example_tr": "Sabah okurum."
   },
   {
    "pattern": "at + night / at the weekend",
    "example_en": "I sleep at night. I play tennis at the weekend.",
    "example_tr": "Gece uyurum. Hafta sonu tenis oynarım."
   },
   {
    "pattern": "on + tarih",
    "example_en": "My birthday is on June fifth.",
    "example_tr": "Doğum günüm 5 Haziran'da."
   },
   {
    "pattern": "What day is it today? — It is + gün.",
    "example_en": "What day is it today? It is Monday.",
    "example_tr": "Bugün günlerden ne? Pazartesi."
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede “pazartesi günü” derken İngilizcede günün önüne on gelir; ayın önüne ise in gelir.",
   "Türkçede “sabah” tek başına yeterli olabilir; İngilizcede bu kalıpta the kullanılır: in the morning.",
   "Türkçede “Bugün günlerden ne?” deriz. İngilizce soruda is, it'ten önce gelir: What day is it today?"
  ],
  "common_mistakes": [
   {
    "wrong": "I study at the morning.",
    "correct": "I study in the morning.",
    "note_tr": "Sabah, öğleden sonra ve akşam için in the kullanılır."
