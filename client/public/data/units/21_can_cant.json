 "lesson": {
  "goal_tr": "Yeteneklerden söz edebilecek, izin isteyebilecek ve can/can’t ile soru sorup kısa cevap verebileceksin.",
  "sections": [
   {
    "heading_tr": "Olumlu ve olumsuz cümle",
    "explanation_tr": "Yeteneklerden söz ederken can, fiilden önce gelir: I can swim. Olumsuz cümlede can’t kullanılır: I can’t swim. Can’t sonrasında fiile -s ya da to eklenmez.",
    "examples": [
     {
      "en": "I can swim.",
      "tr": "Yüzebilirim."
     },
     {
      "en": "She can cook.",
      "tr": "O yemek yapabilir."
     },
     {
      "en": "He can't swim.",
      "tr": "O yüzemez."
     }
    ]
   },
   {
    "heading_tr": "Soru sorma ve kısa cevap",
    "explanation_tr": "Soru için can cümlenin başına gelir. Kısa cevapta can veya can’t kullanılır. Özne he ya da she olsa bile can değişmez.",
    "examples": [
     {
      "en": "Can you swim?",
      "tr": "Yüzebilir misin?"
     },
     {
      "en": "Yes, I can.",
      "tr": "Evet, yüzebilirim."
     },
     {
      "en": "No, I can't.",
      "tr": "Hayır, yüzemem."
     }
    ]
   },
   {
    "heading_tr": "İzin ve rica",
    "explanation_tr": "Can I...? izin istemek için, Can you...? ise birinden bir şey yapmasını rica etmek için kullanılabilir. Bu sorulardan sonra fiil yalın hâlde gelir.",
    "examples": [
     {
      "en": "Can I open the window?",
      "tr": "Pencereyi açabilir miyim?"
     },
     {
      "en": "Can you help me?",
      "tr": "Bana yardım edebilir misin?"
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "I + can + swim",
    "example_en": "I can swim.",
    "example_tr": "Yüzebilirim."
   },
   {
    "pattern": "She + can't + cook",
    "example_en": "She can't cook.",
    "example_tr": "O yemek yapamaz."
   },
   {
    "pattern": "Can + you + swim?",
    "example_en": "Can you swim?",
    "example_tr": "Yüzebilir misin?"
   },
   {
    "pattern": "Can + I + open + the window?",
    "example_en": "Can I open the window?",
    "example_tr": "Pencereyi açabilir miyim?"
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede “Yüzebilirim” tek kelime olabilir; İngilizcede özne ve can gerekir: I can swim.",
   "Türkçede yüklem genellikle sonda, İngilizcede ise özne + can + fiil sırasındadır.",
   "İngilizcede he ve she için can’a -s eklenmez. Türkçedeki “o” gibi, he ve she de cinsiyet belirtir."
  ],
  "common_mistakes": [
