 "lesson": {
  "goal_tr": "Bu dersin sonunda renkleri, boyutları ve duyguları basit sıfatlarla anlatabilir; sıfatları isimlerle ve be fiiliyle doğru kullanabilirsin.",
  "sections": [
   {
    "heading_tr": "Sıfatın yeri",
    "explanation_tr": "Sıfat, ismi anlatıyorsa İngilizcede isimden önce gelir: “a red car”. Be fiilinden sonra da kullanılabilir: “The car is red.”",
    "examples": [
     {
      "en": "I have a red car.",
      "tr": "Kırmızı bir arabam var."
     },
     {
      "en": "The car is red.",
      "tr": "Araba kırmızı."
     }
    ]
   },
   {
    "heading_tr": "a/an ve çoğul isimler",
    "explanation_tr": "Tekil bir ismin önünde sıfat varsa a/an, sıfatın hemen önüne gelir: “a big car”, “an old car”. Seçim, sıfatın ilk sesine göre yapılır; sıfat çoğul isimlerle de değişmeden kalır.",
    "examples": [
     {
      "en": "I have an old car.",
      "tr": "Eski bir arabam var."
     },
     {
      "en": "The cars are red.",
      "tr": "Arabalar kırmızı."
     }
    ]
   },
   {
    "heading_tr": "Renkler, boyutlar ve duygular",
    "explanation_tr": "Renk, boyut ve duygu bildiren sıfatları be fiilinden sonra kullanabilirsin. Very “çok”, not very ise “pek ... değil” anlamı verir ve sıfattan önce gelir.",
    "examples": [
     {
      "en": "The car is very big.",
      "tr": "Araba çok büyük."
     },
     {
      "en": "I am not very happy.",
      "tr": "Pek mutlu değilim."
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "İsim + be + sıfat",
    "example_en": "The car is red.",
    "example_tr": "Araba kırmızı."
   },
   {
    "pattern": "a/an + sıfat + tekil isim",
    "example_en": "I have a big car.",
    "example_tr": "Büyük bir arabam var."
   },
   {
    "pattern": "Çoğul isim + be + sıfat",
    "example_en": "The cars are red.",
    "example_tr": "Arabalar kırmızı."
   },
   {
    "pattern": "Özne + be + very/not very + sıfat",
    "example_en": "Anna is not very happy.",
    "example_tr": "Anna pek mutlu değil."
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede a/an karşılığı yoktur; İngilizcede tekil sayılabilir bir isimden önce kullanmayı unutma.",
   "Türkçede de sıfat genellikle isimden önce gelir: “kırmızı araba” ve “red car”.",
   "Türkçede “Araba kırmızı” diyebilirsin; İngilizcede iki kelimenin arasına is gerekir: “The car is red.”",
   "Türkçedeki “o” cinsiyet belirtmez; İngilizcede renk ve boyut sıfatları da kadın ya da erkek için değişmez."
  ],
  "common_mistakes": [
