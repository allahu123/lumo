 "lesson": {
  "goal_tr": "Bu dersin sonunda kime ait olduğunu sorabilir ve aile üyelerinin eşyalarından söz edebilirsin.",
  "sections": [
   {
    "heading_tr": "Tekil isimlerde sahiplik",
    "explanation_tr": "Bir şeyin kime ait olduğunu belirtmek için sahibin adının sonuna ’s ekle, ardından eşyanın adını söyle. Örneğin, Ali’nin kitabı için “Ali’s book” dersin.",
    "examples": [
     {
      "en": "This is Ali's book.",
      "tr": "Bu, Ali’nin kitabı."
     },
     {
      "en": "My mother's name is Ayse.",
      "tr": "Annemin adı Ayşe."
     }
    ]
   },
   {
    "heading_tr": "Çoğul isimlerle sahiplik",
    "explanation_tr": "Çoğul isim -s ile bitiyorsa sahiplik için sona yalnızca kesme işareti (’) ekle: “brothers’”. “Children” gibi düzensiz çoğul isimlere ise ’s eklenir: “children’s”.",
    "examples": [
     {
      "en": "My brother's room is big.",
      "tr": "Erkek kardeşimin odası büyük."
     },
     {
      "en": "My brothers' room is big.",
      "tr": "Erkek kardeşlerimin odası büyük."
     },
     {
      "en": "The children's room is big.",
      "tr": "Çocukların odası büyük."
     }
    ]
   },
   {
    "heading_tr": "Kime ait olduğunu sorma",
    "explanation_tr": "Bir şeyin kime ait olduğunu sormak için “Whose is this?” diyebilirsin. Kısa cevapta eşyanın adını söylemeden de “It’s Tom’s.” diye yanıt verebilirsin.",
    "examples": [
     {
      "en": "Whose is this? It's Tom's.",
      "tr": "Bu kimin? Tom’un."
     },
     {
      "en": "Whose book is this? It's Tom's.",
      "tr": "Bu kimin kitabı? Tom’un."
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "sahip + 's + eşya",
    "example_en": "This is Ali's book.",
    "example_tr": "Bu, Ali’nin kitabı."
   },
   {
    "pattern": "çoğul isim -s + ' + eşya",
    "example_en": "My brothers' room is big.",
    "example_tr": "Erkek kardeşlerimin odası büyük."
   },
   {
    "pattern": "children + 's + eşya",
    "example_en": "The children's room is big.",
    "example_tr": "Çocukların odası büyük."
   },
   {
    "pattern": "Whose + is + this? — It's + sahibin adı + 's.",
    "example_en": "Whose is this? It's Tom's.",
    "example_tr": "Bu kimin? Tom’un."
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede sahiplik eklerle kurulur; İngilizcede sahibin adından sonra ’s gelir ve eşyanın adı onun ardından söylenir.",
   "Türkçede “Bu kimin?” deriz; İngilizcede soru sırası “Whose is this?” şeklindedir.",
   "Çoğul eki -s ile sahiplik aynı şey değildir: “brothers” erkek kardeşler, “brothers’ room” erkek kardeşlerin odası demektir."
  ],
  "common_mistakes": [
