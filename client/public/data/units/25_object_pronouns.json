 ],
 "lesson": {
  "goal_tr": "Bu dersin sonunda fiil ve edatlardan sonra doğru nesne zamirlerini kullanabilirsin.",
  "sections": [
   {
    "heading_tr": "Nesne zamirleri",
    "explanation_tr": "Bir işten etkilenen kişiyi ya da şeyi gösteren zamirlere nesne zamiri denir. Özne zamirleri I, you, he, she, it, we, they; nesne zamirleri me, you, him, her, it, us, them şeklindedir.",
    "examples": [
     {
      "en": "I see him.",
      "tr": "Onu görüyorum."
     },
     {
      "en": "She likes us.",
      "tr": "O bizden hoşlanıyor."
     }
    ]
   },
   {
    "heading_tr": "Fiil ve edatlardan sonra",
    "explanation_tr": "Nesne zamiri fiilden sonra gelir. Edatlardan, örneğin with ve to’dan sonra da nesne zamiri kullanılır.",
    "examples": [
     {
      "en": "Come with them.",
      "tr": "Onlarla gel."
     },
     {
      "en": "Give it to me.",
      "tr": "Onu bana ver."
     }
    ]
   },
   {
    "heading_tr": "Özneyle farkı",
    "explanation_tr": "I özne zamiriyken me nesne zamiridir; he ve him, she ve her de aynı şekilde eşleşir. You ve it ise özne ve nesne konumunda aynı kalır.",
    "examples": [
     {
      "en": "He sees me.",
      "tr": "O beni görüyor."
     },
     {
      "en": "I see him.",
      "tr": "Ben onu görüyorum."
     }
    ]
   }
  ],
  "key_patterns": [
   {
    "pattern": "Özne + fiil + nesne zamiri",
    "example_en": "I + see + him → I see him.",
    "example_tr": "Ben onu görüyorum."
   },
   {
    "pattern": "Fiil + with + nesne zamiri",
    "example_en": "Come + with + them → Come with them.",
    "example_tr": "Onlarla gel."
   },
   {
    "pattern": "Fiil + it + to + nesne zamiri",
    "example_en": "Give + it + to + me → Give it to me.",
    "example_tr": "Onu bana ver."
   }
  ],
  "turkish_speaker_tips_tr": [
   "Türkçede nesne çoğu zaman fiilden önce gelir; İngilizcede nesne zamiri fiilden sonra gelir: “I see him.”",
   "Türkçedeki “o” cinsiyet belirtmez; İngilizcede erkek için him, kadın için her kullanılır.",
   "You hem özne hem nesne olabilir. Hangi görevde olduğunu cümledeki yerine bakarak anlarsın."
  ],
  "common_mistakes": [
   {
    "wrong": "I see he.",
    "correct": "I see him.",
    "note_tr": "Fiilden sonra özne biçimi he değil, nesne biçimi him kullanılır."
   },
   {
    "wrong": "Come with they.",
    "correct": "Come with them.",
    "note_tr": "With edatından sonra they değil, them gelir."
   },
   {
    "wrong": "She gives I a book.",
    "correct": "She gives me a book.",
    "note_tr": "Give fiilinden sonra kişi nesne zamiriyle belirtilir: me."
   }
  ],
  "mini_dialogue": [
   {
    "speaker": "Anna",
    "en": "I have a book. Do you want it?",
    "tr": "Bir kitabım var. Onu ister misin?"
   },
   {
    "speaker": "Ali",
    "en": "Yes. Give it to me, please.",
    "tr": "Evet. Lütfen onu bana ver."
   },
   {
    "speaker": "Anna",
