    "tr": "Buyur."
   },
   {
    "speaker": "Ali",
    "en": "Thank you. I like it.",
    "tr": "Teşekkür ederim. Onu seviyorum."
   },
   {
    "speaker": "Anna",
    "en": "Come with me.",
    "tr": "Benimle gel."
   }
  ]
 },
